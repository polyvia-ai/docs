            ]
          }
        ]
      },
      { "tab": "Quickstart", "icon": "rocket", "pages": ["quickstart"] },
      { "tab": "Python SDK", "icon": "python", "pages": ["products/python-sdk"] },
      { "tab": "TypeScript SDK", "icon": "js", "pages": ["products/js-sdk"] },
      { "tab": "MCP", "icon": "plug", "pages": ["products/mcp"] },
      { "tab": "Agent Skills", "icon": "robot", "pages": ["products/skills"] }
    ]
