                "pages": [
                  "products/integrations",
                  "products/integrations/google-drive",
                  "products/integrations/dropbox",
                  "products/integrations/onedrive",
                  "products/integrations/notion",
                  "products/integrations/amazon-s3",
                  "products/integrations/slack"
                ]
              }
            ]
          },
          {
            "group": "API Reference",
            "pages": [
              "api-reference/introduction",
              "api-reference/endpoint/ingest",
